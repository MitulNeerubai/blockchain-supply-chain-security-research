# ─────────────────────────────────────────────────────────────────────────────
#  TEMPLATE — copy this file to `.env` and fill in YOUR values:
#      Windows (PowerShell):  copy .env.example .env
#      macOS / Linux:         cp .env.example .env
#  `.env` is git-ignored. NEVER commit it or share it — it holds your private key.
# ─────────────────────────────────────────────────────────────────────────────

# PASTE YOUR DEPLOYER WALLET PRIVATE KEY HERE (64 hex characters, with or without 0x).
# This wallet becomes rootGA (the root of trust) and must hold some TRUST for gas.
# MetaMask → ⋮ → Account details → Show private key
PRIVATE_KEY_ROOTGA=PASTE_YOUR_ROOTGA_PRIVATE_KEY_HERE

# Optional: other role wallets (not needed to deploy or to use the web app)
PRIVATE_KEY_LG=
PRIVATE_KEY_MF=
PRIVATE_KEY_DT=
PRIVATE_KEY_RT=

# Optional: RPC override (default https://eth.didlab.org)
# BESU_RPC=https://eth.didlab.org

# PASTE YOUR GMAIL ADDRESS + GMAIL APP PASSWORD HERE (used to send verification codes
# and notifications). Create an App Password: Google Account → Security → 2-Step
# Verification → App passwords. Do NOT use your normal Gmail password.
GMAIL_USER=PASTE_YOUR_EMAIL@gmail.com
GMAIL_PASS=PASTE_YOUR_16_CHARACTER_APP_PASSWORD

# Optional: auto-revert keeper (used by `npm run notifier`). Any wallet with a little
# TRUST for gas. When a licence is revoked or expires, in-transit shipments to that
# company are sent back to the sender automatically. Leave blank to disable.
KEEPER_PRIVATE_KEY=

# Optional server settings
# APP_PORT=3001
# STATIC_DIR=dist
# PORTAL_URL=https://your-site.example.com
